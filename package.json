{
  "name": "forge",
  "productName": "Forge",
  "version": "0.1.0",
  "private": true,
  "author": "Magnus Opera SAS",
  "license": "MIT",
  "type": "module",
  "description": "A focus-first desktop GitHub client.",
  "main": "dist-electron/electron/main/main.js",
  "scripts": {
    "dev": "node scripts/prepare-github-oauth.mjs && concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:main": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist-electron/electron/main/main.js && electron .",
    "build": "node scripts/prepare-github-oauth.mjs && tsc -p tsconfig.electron.json && vite build",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64 --publish never",
    "website": "npm run website:build && vite --host 127.0.0.1 --port 4174 .out/site",
    "website:build": "node website/build.mjs",
    "test": "vitest run --reporter=default --reporter=junit --outputFile.junit=.out/test-results/unit.xml",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "postinstall": "node scripts/prepare-terminal.cjs"
  },
  "build": {
    "appId": "com.magnusopera.forge",
    "productName": "Forge",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": ".out/electron"
    },
    "files": [
      "assets/**/*",
      "dist/renderer/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/forge-icon.icns",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/**/*"
    ]
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.5",
    "@octokit/rest": "^22.0.1",
    "@pierre/diffs": "^1.6.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "ghostty-web": "^0.4.0",
    "lucide-react": "^1.65.0",
    "mermaid": "^12.2.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
